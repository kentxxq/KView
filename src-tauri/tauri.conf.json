{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KView",
  "version": "0.1.0",
  "identifier": "com.kentx.kview",
  "build": {
    "beforeDevCommand": "vpr dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vpr build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "png", "webp", "gif", "svg", "txt", "log", "json", "yaml", "yml", "xml", "toml", "ini", "env", "conf", "sql", "md", "markdown", "pdf", "docx", "xlsx", "mp4", "webm"],
        "name": "KView 支持的文件",
        "description": "使用 KView 快速查看文件",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
