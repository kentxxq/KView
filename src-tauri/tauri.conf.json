{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kview",
  "version": "0.1.0",
  "identifier": "com.kentx.kview",
  "build": {
    "beforeDevCommand": "vpr dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vpr build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KView",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
