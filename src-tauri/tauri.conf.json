{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KView",
  "version": "1.0.3",
  "identifier": "com.kentxxq.kview",
  "build": {
    "beforeDevCommand": "vpr dev",
    "devUrl": "http://localhost:1800",
    "beforeBuildCommand": "vpr build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1800 ws://localhost:1801"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQzEyMjdCOEEzM0Y2NUIKUldSYjlqT0tleUxCL1l6VkZZMmZGWXdkcEl5NnVtZ2N0Zm9LbU9BRE94cTQ5K2hmQzJOekw2d2kK",
      "endpoints": ["https://github.com/kentxxq/KView/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "heic",
          "heif",
          "livp",
          "png",
          "webp",
          "gif",
          "svg",
          "txt",
          "log",
          "json",
          "yaml",
          "yml",
          "xml",
          "toml",
          "ini",
          "env",
          "conf",
          "config",
          "properties",
          "sql",
          "csv",
          "tsv",
          "md",
          "markdown",
          "js",
          "jsx",
          "mjs",
          "cjs",
          "ts",
          "tsx",
          "mts",
          "cts",
          "vue",
          "html",
          "htm",
          "css",
          "scss",
          "sass",
          "less",
          "py",
          "java",
          "kt",
          "kts",
          "c",
          "h",
          "cc",
          "cpp",
          "cxx",
          "hpp",
          "cs",
          "go",
          "rs",
          "php",
          "rb",
          "swift",
          "dart",
          "lua",
          "sh",
          "bash",
          "zsh",
          "fish",
          "ps1",
          "bat",
          "cmd",
          "graphql",
          "gql",
          "proto",
          "gitignore",
          "gitattributes",
          "editorconfig",
          "pdf",
          "doc",
          "docx",
          "xls",
          "xlsx",
          "epub",
          "mobi",
          "zip",
          "tar",
          "tgz",
          "gz",
          "mp3",
          "wav",
          "m4a",
          "aac",
          "flac",
          "ogg",
          "opus",
          "mp4",
          "webm",
          "mov"
        ],
        "name": "KView 支持的文件",
        "description": "使用 KView 快速查看文件",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
